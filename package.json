{
  "name": "reto-03-agente-oc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agente conversacional que prepara y crea \u00f3rdenes de compra en un SAP simulado.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch src/server.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx src/server.ts",
    "demo": "tsx demo.ts",
    "typecheck": "tsc --noEmit",
    "reset": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\""
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^7.53.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
