# Copiar a .env y completar. Nunca subir .env al repositorio.
# Sin OPENAI_API_KEY el servidor arranca, pero el chat devuelve un error claro.
# Cubierto por `npm run demo`, que no necesita clave.

# Clave de OpenAI. Solo backend; nunca se envía al front ni aparece en logs.
OPENAI_API_KEY=

# Modelo de OpenAI usado por el agente (Chat Completions con function calling).
OPENAI_MODEL=gpt-4.1-mini

# Tiempo máximo de espera por respuesta del modelo, en milisegundos.
LLM_TIMEOUT_MS=30000

# Tope de llamadas al modelo por turno del usuario (evita bucles y gasto excesivo).
MAX_ITERATIONS_PER_TURN=25

# Tope de tokens acumulados por sesión (control de costo).
MAX_TOKENS_PER_SESSION=200000

# Puerto del servidor HTTP. Render lo asigna automáticamente en producción.
PORT=3000
